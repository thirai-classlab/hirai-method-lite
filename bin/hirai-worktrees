#!/usr/bin/env python3
# hirai-worktrees: 今のリポの worktree を 1 行ずつ、「消してよい／残す」を理由つきで出す。消す操作は持たない。
#
#   hirai-worktrees list [--orca] [--json]
#
#   消してよい = 次の 1〜8 が全部そろった worktree だけ。1 つでも欠ける・読めないときは理由つきで「残す」。
#     1 作業がない          : git status --porcelain が空（GIT_OPTIONAL_LOCKS=0 を全部の git に付け、index.lock を取らない）
#     2 動いているプロセスが無い: その worktree か下を cwd に持つプロセスが 0（lsof -w -d cwd -Fpn を 1 回だけ打つ。無ければ
#                           /proc/*/cwd。どちらも読めなければ「プロセス 未確認」＝残す。自分とその親のプロセスは数えない）
#     3 動いている端末が無い  : orca terminal list --json にその worktree の端末が 0 本（worktreePath が空なら worktreeId の
#                           `::` の後ろを使う。どちらも無い端末・truncated: true があれば「端末 未確認」＝残す）。
#                           入れ子の worktree は、祖先の worktree に端末かプロセスがあれば「残す（外側の worktree が使用中）」
#     4 対象外              : 本体の checkout・今いる worktree・locked・prunable・bare は常に残す
#     5 入れ子が無い        : その path の下にほかの worktree が無い（locked・detached・prunable の入れ子も数える）
#     6 branch がある       : detached は残す
#     7 取り込み済み        : 先頭が既定の branch（origin/HEAD）の祖先／git cherry が全部 `-`／下の 8 の PR が MERGED
#     8 中身が origin にある : upstream があり @{u}.. が 0 件、または HEAD の commit を head に持つ PR が MERGED
#                           （gh api repos/{owner}/{repo}/commits/<HEAD>/pulls のうち merged_at があり head.sha が HEAD と同じもの。
#                           Orca の branch 名は PR の head と違うので名前で引かない）。upstream が無く PR も確かめられないときは
#                           「残す（upstream が無い）」。中身が既定の branch に入っているだけでは通さない
#   無視されるファイルのうち作り直せないもの（node_modules・dist・build・out・.next・.turbo・.cache・coverage・__pycache__・.venv・
#   .pytest_cache・playwright-report・test-results・*.tsbuildinfo・.eslintcache・.DS_Store 以外）を先頭の dir ごとに数え、1 件以上なら
#   「消してよい（退避が要る: .tmp 12 件・…）」と出す（verdict は「消してよい」のまま。JSON の evacuate の配列）。数は上限 1,000 で止め「1000 件以上」。
#   「消してよい」の行には「持ち主の会話: 未確認（コーディネーターが確かめる）」を付ける。
#   local-ci.sh の lci-* と Workflow の .claude/worktrees の agent-*・wf_* も一覧に出る。
#   --orca : orca が無ければ exit 2（付けなければ orca が無いとき「端末 未確認」で続ける）
#   --json : 1 行 1 worktree でなく、配列で出す（path・branch・verdict・reasons・conditions・evacuate）
#   末尾の 1 行に消し方を出す。`git worktree remove <path>` は branch を残す。`orca worktree rm` は merge 済みの手元の branch も
#   消そうとするので、残したいときは使わない。
# exit code: 0 = 一覧が出た／2 = git のリポでない・使い方の誤り
import fnmatch
import json
import os
import shutil
import subprocess
import sys

GIT_TIMEOUT = 30
GH_TIMEOUT = 20
ORCA_TIMEOUT = 20
PS_TIMEOUT = 10
KEEP = "残す"
OK = "消してよい"
OWNER_NOTE = "持ち主の会話: 未確認（コーディネーターが確かめる）"
REMOVE_HOW = ("消し方: `git worktree remove <path>`（branch は残る）。`orca worktree rm` は merge 済みの手元の branch も"
              "消そうとするので、残したいときは使わない")
EVACUATE_CAP = 1000
# 作り直せる dir・ファイル（無視されていても退避は要らない）
REGENERABLE_DIRS = {"node_modules", "dist", "build", "out", ".next", ".turbo", ".cache", "coverage", "__pycache__",
                    ".venv", ".pytest_cache", "playwright-report", "test-results"}
REGENERABLE_FILES = ("*.tsbuildinfo", ".eslintcache", ".DS_Store")


def usage():
    sys.stderr.write("usage: hirai-worktrees list [--orca] [--json]\n")
    sys.exit(2)


def run(cmd, cwd=None, timeout=GIT_TIMEOUT):
    """(exit code, stdout)。起動できない・時間切れは (None, '')。git には GIT_OPTIONAL_LOCKS=0 を付ける（読むだけで index.lock を取らない）。"""
    env = dict(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None, ""
    return p.returncode, p.stdout


def git(args, cwd):
    return run(["git", "-C", cwd] + args)


def list_worktrees(cwd):
    code, out = git(["worktree", "list", "--porcelain"], cwd)
    if code != 0:
        return None
    rows, cur = [], None
    for line in out.splitlines() + [""]:
        if not line.strip():
            if cur:
                rows.append(cur)
            cur = None
            continue
        key, _, val = line.partition(" ")
        if key == "worktree":
            cur = {"path": val, "head": "", "branch": None, "locked": False, "prunable": False, "bare": False}
        elif cur is not None:
            if key == "HEAD":
                cur["head"] = val
            elif key == "branch":
                cur["branch"] = val[len("refs/heads/"):] if val.startswith("refs/heads/") else val
            elif key == "locked":
                cur["locked"] = True
            elif key == "prunable":
                cur["prunable"] = True
            elif key == "bare":
                cur["bare"] = True
    return rows


def default_ref(cwd):
    code, out = git(["symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd)
    if code == 0 and out.strip():
        return out.strip()
    for cand in ("origin/main", "origin/master", "origin/stg"):
        c, _ = git(["rev-parse", "--verify", "-q", cand], cwd)
        if c == 0:
            return cand
    return None




def in_default(wt, default):
    """先頭が既定の branch の祖先か、git cherry が全部 `-`。"""
    if default is None:
        return False
    code, _ = git(["merge-base", "--is-ancestor", "HEAD", default], wt)
    if code == 0:
        return True
    code, out = git(["cherry", default, "HEAD"], wt)
    return code == 0 and all(l.startswith("-") for l in out.splitlines() if l.strip())




def real(p):
    return os.path.realpath(p)


def under(child, parent):
    """child が parent と同じか下にある（realpath 済みの path 同士）。"""
    return child == parent or child.startswith(parent.rstrip("/") + "/")


def ancestor_pids():
    """自分とその親のプロセス番号の集合。ps が読めなければ自分と直接の親だけ。"""
    pids = {os.getpid(), os.getppid()}
    code, out = run(["ps", "-A", "-o", "pid=,ppid="], timeout=PS_TIMEOUT)
    if code != 0:
        return pids
    parent = {}
    for line in out.splitlines():
        f = line.split()
        if len(f) == 2 and f[0].isdigit() and f[1].isdigit():
            parent[int(f[0])] = int(f[1])
    cur = os.getpid()
    for _ in range(64):
        cur = parent.get(cur)
        if not cur or cur <= 1:
            break
        pids.add(cur)
    return pids


def process_cwds():
    """[(pid, cwd の realpath)]。lsof を 1 回だけ打ち、無ければ /proc/*/cwd。どちらも読めなければ None。"""
    skip = ancestor_pids()
    rows = None
    if shutil.which("lsof"):
        env = dict(os.environ)
        try:
            proc = subprocess.Popen(["lsof", "-w", "-d", "cwd", "-Fpn"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True, env=env)
            skip.add(proc.pid)
            out, _ = proc.communicate(timeout=GIT_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired):
            out = ""
        pid, got = None, []
        for line in out.splitlines():
            if line.startswith("p") and line[1:].isdigit():
                pid = int(line[1:])
            elif line.startswith("n") and pid is not None:
                got.append((pid, line[1:]))
        if got:
            rows = got
    if rows is None and os.path.isdir("/proc/self"):
        got = []
        try:
            names = os.listdir("/proc")
        except OSError:
            names = []
        for n in names:
            if n.isdigit():
                try:
                    got.append((int(n), os.readlink("/proc/%s/cwd" % n)))
                except OSError:
                    continue
        if got:
            rows = got
    if rows is None:
        return None
    return [(pid, real(c)) for pid, c in rows if pid not in skip]


def orca_terminals():
    """端末の path の realpath の一覧（1 本 1 要素）。読めない・path の無い端末がある・truncated のときは None。"""
    if not shutil.which("orca"):
        return None
    code, out = run(["orca", "terminal", "list", "--json"], timeout=ORCA_TIMEOUT)
    if code != 0:
        return None
    try:
        data = json.loads(out)
        res = data["result"] if isinstance(data.get("result"), dict) else data
        terms = res["terminals"]
    except (ValueError, KeyError, TypeError, AttributeError):
        return None
    if data.get("truncated") is True or res.get("truncated") is True:
        return None
    paths = []
    for t in terms:
        if not isinstance(t, dict):
            return None
        if t.get("truncated") is True:
            return None
        p = t.get("worktreePath")
        if not p:
            wid = t.get("worktreeId")
            p = wid.split("::", 1)[1] if isinstance(wid, str) and "::" in wid else None
        if not p:
            return None
        paths.append(real(p))
    return paths


def pr_merged(wt, head, cache):
    """HEAD の commit を head に持つ PR が MERGED か。True / False / None（gh が無い・失敗）。1 worktree 1 回だけ引く。"""
    if "v" in cache:
        return cache["v"]
    val = None
    if head and os.environ.get("HIRAI_WORKTREES_NO_GH") != "1" and shutil.which("gh"):
        code, out = run(["gh", "api", "repos/{owner}/{repo}/commits/%s/pulls" % head], cwd=wt, timeout=GH_TIMEOUT)
        if code == 0:
            try:
                prs = json.loads(out)
                val = any(isinstance(p, dict) and p.get("merged_at")
                          and (p.get("head") or {}).get("sha") == head for p in prs)
            except (ValueError, TypeError, AttributeError):
                val = None
    cache["v"] = val
    return val


def is_regenerable_file(name):
    return any(fnmatch.fnmatch(name, pat) for pat in REGENERABLE_FILES)


def count_files(top, skip_roots, budget):
    """top の下の、作り直せないファイル数（budget まで）。ほかの worktree の下は数えない。"""
    n = 0
    if os.path.isfile(top) or os.path.islink(top):
        return 0 if is_regenerable_file(os.path.basename(top)) else 1
    for root, dirs, files in os.walk(top):
        dirs[:] = [d for d in dirs if d not in REGENERABLE_DIRS and real(os.path.join(root, d)) not in skip_roots]
        n += sum(1 for f in files if not is_regenerable_file(f))
        if n >= budget:
            return budget
    return n


def evacuation(wt, ignored, others):
    """無視されるファイルのうち作り直せないものを、先頭の dir ごとに数える。[{"dir", "count"}]（count は上限 EVACUATE_CAP）。"""
    skip_roots = {o for o in others if under(o, real(wt))}
    counts, total = {}, 0
    for rel in ignored:
        rel = rel.rstrip("/")
        base = os.path.basename(rel)
        if base in REGENERABLE_DIRS or is_regenerable_file(base):
            continue
        n = count_files(os.path.join(wt, rel), skip_roots, EVACUATE_CAP - total)
        if n:
            top = rel.split("/", 1)[0]
            counts[top] = counts.get(top, 0) + n
            total += n
        if total >= EVACUATE_CAP:
            break
    return [{"dir": k, "count": v} for k, v in counts.items()]


def evac_text(evac):
    total = sum(e["count"] for e in evac)
    parts = [("%s %s" % (e["dir"], ("1000 件以上" if total >= EVACUATE_CAP and e["count"] >= EVACUATE_CAP else "%d 件" % e["count"])))
             for e in evac]
    if total >= EVACUATE_CAP and not any(e["count"] >= EVACUATE_CAP for e in evac):
        parts.append("合計 1000 件以上")
    return "退避が要る: " + "・".join(parts)


def judge(row, default, ctx, cache_gh):
    wt = row["path"]
    rwt = real(wt)
    conds, reasons = {}, []

    code, out = git(["status", "--porcelain", "--ignored"], wt)
    ignored = []
    if code != 0:
        conds["clean"] = False
        reasons.append("作業の有無を読めない（git status が失敗）")
    else:
        dirty = [l for l in out.splitlines() if l.strip() and not l.startswith("!! ")]
        ignored = [l[3:] for l in out.splitlines() if l.startswith("!! ")]
        conds["clean"] = not dirty
        if dirty:
            reasons.append("作業がある（未コミット %d 件）" % len(dirty))

    # 5 入れ子
    nested = [o for o in ctx["all_paths"] if o != rwt and under(o, rwt)]
    conds["no_nested"] = not nested
    if nested:
        reasons.append("入れ子の worktree がある: " + "・".join(nested[:3]) + (" ほか" if len(nested) > 3 else ""))

    # 2 プロセス
    procs = ctx["procs"]
    if procs is None:
        conds["process"] = None
        reasons.append("プロセス 未確認")
    else:
        n = sum(1 for _, c in procs if under(c, rwt))
        conds["process"] = n == 0
        if n:
            reasons.append("動いているプロセスがある（%d 本）" % n)

    # 3 端末（祖先の worktree の端末・プロセスも見る）
    terms = ctx["terms"]
    if terms is None:
        conds["terminal"] = None
        reasons.append("端末 未確認")
    else:
        n = sum(1 for t in terms if t == rwt)
        conds["terminal"] = n == 0
        if n:
            reasons.append("動いている端末がある（%d 本）" % n)
    outer_used = []
    for a in ctx["all_paths"]:
        if a != rwt and under(rwt, a):
            used = (terms is not None and any(t == a for t in terms)) or (procs is not None and any(under(c, a) for _, c in procs))
            if used:
                outer_used.append(a)
    conds["outer_idle"] = not outer_used
    if outer_used:
        reasons.append("外側の worktree が使用中: " + outer_used[0])

    # 6 branch
    conds["branch"] = bool(row["branch"])
    if not row["branch"]:
        reasons.append("detached（branch が無い）")

    # 7 取り込み済み
    merged_local = in_default(wt, default)
    if default is None:
        reasons.append("既定の branch を決められない（origin/HEAD が無い）")
    gh_note = ""
    if merged_local:
        conds["merged"] = True
    else:
        g = pr_merged(wt, row["head"], cache_gh)
        conds["merged"] = g is True
        if g is not True:
            if g is None:
                gh_note = "（gh 未確認）"
            reasons.append("取り込み済みでない" + gh_note)

    # 8 中身が origin にある
    up_ok = False
    has_up = False
    if row["branch"]:
        c, _ = git(["rev-parse", "--verify", "-q", "@{u}"], wt)
        has_up = c == 0
    if has_up:
        c2, out = git(["rev-list", "--count", "@{u}.."], wt)
        n = out.strip()
        up_ok = c2 == 0 and n == "0"
    if up_ok:
        conds["pushed"] = True
    else:
        g = pr_merged(wt, row["head"], cache_gh)
        conds["pushed"] = g is True
        if g is not True:
            if not has_up:
                reasons.append("upstream が無い" + ("（PR も gh 未確認）" if g is None else "（merge 済みの PR も無い）"))
            else:
                reasons.append("未 push がある（@{u}.. が 0 件でない）")

    keys = ("clean", "no_nested", "process", "terminal", "outer_idle", "branch", "merged", "pushed")
    ok = all(conds[k] is True for k in keys)
    evac = evacuation(wt, ignored, ctx["all_paths"]) if ok else []
    return ok, conds, reasons, evac


def main(argv):
    if not argv or argv[0] != "list":
        usage()
    flags = argv[1:]
    for f in flags:
        if f not in ("--orca", "--json"):
            usage()
    want_orca, as_json = "--orca" in flags, "--json" in flags
    if want_orca and not shutil.which("orca"):
        sys.stderr.write("hirai-worktrees: orca が PATH に無い\n")
        return 2
    cwd = os.getcwd()
    code, top = git(["rev-parse", "--show-toplevel"], cwd)
    if code != 0 or not top.strip():
        sys.stderr.write("hirai-worktrees: git のリポの中で打つ\n")
        return 2
    here = top.strip()
    rows = list_worktrees(here)
    if rows is None:
        sys.stderr.write("hirai-worktrees: git worktree list に失敗\n")
        return 2
    default = default_ref(here)
    ctx = {"terms": orca_terminals(), "procs": process_cwds(), "all_paths": [real(r["path"]) for r in rows]}
    results = []
    for i, row in enumerate(rows):
        wt = row["path"]
        skip = None
        if i == 0:
            skip = "本体の checkout"
        elif os.path.exists(wt) and os.path.exists(here) and os.path.samefile(wt, here):
            skip = "今いる worktree"
        elif row["locked"]:
            skip = "locked"
        elif row["prunable"]:
            skip = "prunable（path が無い）"
        elif row["bare"]:
            skip = "bare"
        if skip:
            results.append({"path": wt, "branch": row["branch"], "verdict": KEEP, "reasons": ["対象外: " + skip],
                            "conditions": {}, "evacuate": []})
            continue
        ok, conds, reasons, evac = judge(row, default, ctx, {})
        if ok:
            reasons = ["作業なし・プロセスなし・端末なし・取り込み済み・origin にある"] + ([evac_text(evac)] if evac else []) + [OWNER_NOTE]
        results.append({"path": wt, "branch": row["branch"], "verdict": OK if ok else KEEP,
                        "reasons": reasons, "conditions": conds, "evacuate": evac})
    if as_json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
        return 0
    for r in results:
        print("%s  %s  [%s]  %s" % (r["verdict"], r["path"], r["branch"] or "detached", "／".join(r["reasons"])))
    n = sum(1 for r in results if r["verdict"] == OK)
    m = sum(1 for r in results if r["verdict"] == OK and r["evacuate"])
    print("消してよい: %d 本（うち退避が要る %d 本。消す操作はこの道具に無い）" % (n, m))
    print(REMOVE_HOW)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
