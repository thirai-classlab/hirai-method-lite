#!/usr/bin/env python3
# hirai-watch: 担当の会話の「止まり」（API エラーで手番が終わった・問い合わせの途中で更新が止まった）を、会話の記録から見つける。
#
#   hirai-watch [--minutes N] [--orca] [<worktree の path> ...]
#
#   各 worktree の記録の dir（~/.claude/projects/<path の / と . を - にした名前>/）のうち最新の .jsonl を読み、
#   次のどちらかなら「止まり」として 1 行ずつ出す。1 件でもあれば exit 1、無ければ何も出さず exit 0。
#     (a) 最後の会話の行（user・assistant・system の turn_duration）が isApiErrorMessage の assistant か、その直後の turn_duration
#     (b) 最後の行が api-request か、最後の会話の行が user（tool_result を含む）で、記録の更新が N 分（既定 15）より前
#   stop_reason が end_turn の assistant で終わっている会話は、何分たっていても出さない（普通の待ち）。
#   記録の dir が無い worktree は「記録が無い」と出すだけで、止まりに数えない。
#   --orca: `orca worktree list --json` から、今のリポ（git remote origin の slug）と同じ projectId の worktree を全部見る。
#           orca が無ければ exit 2。path も --orca も無ければ、cwd の git のトップを見る。
#   秘密を含みうる本文は出さない（API エラーの文の先頭 80 字だけ）。読み取りだけで、何も書き換えない。
# 回し方の例: 10 分ごとに `hirai-watch --orca --minutes 15` を回し、exit 1 のときだけ出力を見て、止まった担当の端末に「続けて」を送る。
import json
import os
import re
import subprocess
import sys
import time

DEFAULT_MINUTES = 15
HEAD_CHARS = 80
TAIL_BYTES = 2 * 1024 * 1024


def usage():
    sys.stderr.write("usage: hirai-watch [--minutes N] [--orca] [<worktree の path> ...]\n")
    sys.exit(2)


def projects_root():
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    return os.path.join(base, "projects")


def record_dirs(path):
    real = os.path.realpath(path)
    names = []
    for p in (path, real):
        for pat in (r"[/.]", r"[^A-Za-z0-9]"):
            n = re.sub(pat, "-", p)
            if n not in names:
                names.append(n)
    return [os.path.join(projects_root(), n) for n in names]


def latest_record(path):
    best = None
    for d in record_dirs(path):
        if not os.path.isdir(d):
            continue
        for f in os.listdir(d):
            if f.endswith(".jsonl"):
                fp = os.path.join(d, f)
                m = os.path.getmtime(fp)
                if best is None or m > best[1]:
                    best = (fp, m)
    return best


def read_rows(fp):
    size = os.path.getsize(fp)
    with open(fp, "rb") as fh:
        if size > TAIL_BYTES:
            fh.seek(size - TAIL_BYTES)
            fh.readline()
        data = fh.read().decode("utf-8", "replace")
    rows = []
    for line in data.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict):
            rows.append(r)
    return rows


def is_conv(r):
    t = r.get("type")
    if r.get("isSidechain"):
        return False
    return t in ("user", "assistant") or (t == "system" and r.get("subtype") == "turn_duration")


def head_text(r):
    c = (r.get("message") or {}).get("content")
    if isinstance(c, list):
        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
    c = re.sub(r"\s+", " ", c if isinstance(c, str) else "").strip()
    return c[:HEAD_CHARS]


def judge(fp, mtime, minutes):
    rows = read_rows(fp)
    conv = [r for r in rows if is_conv(r)]
    if not rows or not conv:
        return None
    last = conv[-1]
    err = None
    if last.get("type") == "assistant" and last.get("isApiErrorMessage"):
        err = last
    elif last.get("type") == "system" and len(conv) >= 2:
        prev = conv[-2]
        if prev.get("type") == "assistant" and prev.get("isApiErrorMessage"):
            err = prev
    if err is not None:
        return "API エラーで止まった（%s・%s）" % (err.get("timestamp", "時刻不明"), head_text(err) or "本文なし")
    age = (time.time() - mtime) / 60.0
    if age < minutes:
        return None
    if rows[-1].get("type") == "api-request" or last.get("type") == "user":
        return "問い合わせの途中で %d 分止まっている" % int(age)
    return None


def repo_slug(cwd):
    try:
        url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return ""
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else ""


def orca_paths():
    slug = repo_slug(os.getcwd())
    if not slug:
        sys.stderr.write("hirai-watch: origin の remote から repo を読めない（--orca）\n")
        sys.exit(2)
    try:
        out = subprocess.run(["orca", "worktree", "list", "--json"], capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        sys.stderr.write("hirai-watch: orca コマンドが PATH に無い（--orca）\n")
        sys.exit(2)
    except subprocess.CalledProcessError as e:
        sys.stderr.write("hirai-watch: orca worktree list が失敗した（exit %d）\n" % e.returncode)
        sys.exit(2)
    try:
        data = json.loads(out)
    except ValueError:
        sys.stderr.write("hirai-watch: orca worktree list の出力が JSON でない\n")
        sys.exit(2)
    items = (data.get("result") or data).get("worktrees", []) if isinstance(data, dict) else data
    want = "github:" + slug
    return [w["path"] for w in items if isinstance(w, dict) and w.get("projectId") == want and w.get("path") and not w.get("isArchived")]


def main(argv):
    minutes = DEFAULT_MINUTES
    use_orca = False
    paths = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--minutes":
            if i + 1 >= len(argv) or not argv[i + 1].isdigit():
                usage()
            minutes = int(argv[i + 1])
            i += 2
        elif a == "--orca":
            use_orca = True
            i += 1
        elif a.startswith("-"):
            usage()
        else:
            paths.append(a)
            i += 1
    if use_orca:
        paths += orca_paths()
    if not paths:
        try:
            top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            top = os.getcwd()
        paths = [top]
    stalled = 0
    for p in dict.fromkeys(paths):
        rec = latest_record(p)
        if rec is None:
            print("%s: 記録が無い" % p)
            continue
        msg = judge(rec[0], rec[1], minutes)
        if msg:
            stalled += 1
            print("%s: %s" % (p, msg))
    sys.exit(1 if stalled else 0)


main(sys.argv[1:])
