#!/usr/bin/env bash
#
# hirai-pr-asset — PR の本文に載せる画像（画面のキャプチャ）を branch pr-assets に置き、本文に貼る 1 行を出す。
#
# なぜ要るか: 画像を PR の branch に入れると、squash で既定 branch の履歴に残る。そこで画像だけを積む branch pr-assets に置き、
#   blob の URL で載せる（本文を file から書き直しても URL が変わらない。gh の --attach との違いは git-and-pr.md §9）。
#
# 使い方:
#   hirai-pr-asset <PR 番号> <png ...>                    # 置いて、貼る 1 行を出す
#   hirai-pr-asset --remote <名前> <PR 番号> <png ...>    # 押し先の remote を替える（既定 origin）
#
# 作業ツリーの branch と index は動かさない（使い捨ての index で commit を作って push だけする）。
# 同じ名前の画像を同じ PR 番号で置くと上書きする（前の版は pr-assets の履歴に残る）。
# 押し先の slug は git の remote の URL から引く。remote を読めない・GitHub の owner/repo を読めないときは、押さずに exit 1。
# URL の中の認証情報（https://<token>@…）は、貼る 1 行にも表示にも出さない。
set -euo pipefail

remote=origin
if [ "${1:-}" = "--remote" ]; then remote="${2:?--remote には名前が要る}"; shift 2; fi
pr="${1:-}"
case "$pr" in ''|*[!0-9]*) echo "使い方: hirai-pr-asset [--remote <名前>] <PR 番号> <png ...>" >&2; exit 2 ;; esac
shift
[ $# -ge 1 ] || { echo "画像のファイルを 1 つ以上渡す" >&2; exit 2; }
for f in "$@"; do
  [ -f "$f" ] || { echo "ファイルが無い: ${f}" >&2; exit 2; }
  case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.webp) ;; *) echo "画像でない: ${f}（png・jpg・gif・webp）" >&2; exit 2 ;; esac
done

branch="pr-assets"
mask() { sed -E 's#(https?://)[^/]*@#\1#g'; }
url="$(git remote get-url "$remote" 2>&1)" || { echo "remote を読めない（${remote}）: $(printf '%s' "$url" | mask)" >&2; exit 1; }
slug="$(printf '%s\n' "$url" | mask | sed -E 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)##; s#/$##; s#\.git$##')"
[[ "$slug" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { echo "${remote} の URL から GitHub の owner/repo を読めない（URL は出さない）。--remote で GitHub の remote を指す" >&2; exit 1; }

parent=""
rc=0; out="$(git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" 2>&1)" || rc=$?
case "$rc" in
  0) out="$(git fetch -q "$remote" "refs/heads/$branch" 2>&1)" || { echo "pr-assets を取れない: $(printf '%s' "$out" | mask)" >&2; exit 1; }
     parent="$(git rev-parse FETCH_HEAD)" ;;
  2) ;;  # まだ無い → 最初の commit を作る
  *) echo "remote を読めない（${remote}・exit ${rc}）: $(printf '%s' "$out" | mask)" >&2; exit 1 ;;
esac

idx="$(mktemp -u "${TMPDIR:-/tmp}/pr-asset-index.XXXXXX")"
trap 'rm -f "$idx"' EXIT
if [ -n "$parent" ]; then GIT_INDEX_FILE="$idx" git read-tree "$parent"; else GIT_INDEX_FILE="$idx" git read-tree --empty; fi
for f in "$@"; do
  blob="$(git hash-object -w "$f")"
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$pr/$(basename "$f")"
done
tree="$(GIT_INDEX_FILE="$idx" git write-tree)"
msg="pr-assets: #${pr} に画像 ${#} 枚"
if [ -n "$parent" ]; then commit="$(git commit-tree "$tree" -p "$parent" -m "$msg")"; else commit="$(git commit-tree "$tree" -m "$msg")"; fi
git push -q "$remote" "$commit:refs/heads/$branch"

for f in "$@"; do
  name="$(basename "$f")"
  printf '![%s](https://github.com/%s/blob/%s/%s/%s?raw=true)\n' "${name%.*}" "$slug" "$branch" "$pr" "$name"
done
